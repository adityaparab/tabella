{
  "name": "@tabella/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx src/seed/cli.ts",
    "migrate": "node-pg-migrate -m migrations up",
    "migrate:down": "node-pg-migrate -m migrations down 1",
    "migrate:create": "node-pg-migrate -m migrations create"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@tabella/shared": "workspace:*",
    "fastify": "^5.6.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
